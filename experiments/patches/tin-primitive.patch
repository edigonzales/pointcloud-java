+    // SplitMix64's bijective finalizer mixes both packed coordinate halves before hashing.
+    private static long mixXY(long value) {
+        value = (value ^ (value >>> 30)) * 0xbf58476d1ce4e5b9L;
+        value = (value ^ (value >>> 27)) * 0x94d049bb133111ebL;
