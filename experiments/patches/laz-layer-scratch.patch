@@ -0,0 +1,64 @@
+package com.github.mreutegg.laszip4j.laszip;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class LayerPayloadTest {
+    @Test
+    void readsAdjacentLittleEndianViewsWithoutCopying() {
+        byte[] bytes = {1, 2, 3, 4};
+        var payload = new ByteStreamInArray();
+        payload.initLayerPayload(bytes, bytes.length);
+        var first = new ByteStreamInArray();
+        var second = new ByteStreamInArray();
+        first.readLayerFrom(payload, 2);
+        second.readLayerFrom(payload, 2);
+
+        bytes[0] = 5;
+        assertEquals((char) 0x0205, first.get16bitsLE());
+        assertThrows(UncheckedEOFException.class, first::getByte);
+        assertEquals((char) 0x0403, second.get16bitsLE());
+        assertEquals(4, payload.tell());
+    }
+
+    @Test
+    void respectsShorterPayloadsAndEmptyOrSkippedLayers() {
+        byte[] bytes = {1, 2, 3, 4, 5};
+        var payload = new ByteStreamInArray();
+        var layer = new ByteStreamInArray();
+        payload.initLayerPayload(bytes, bytes.length);
+        layer.readLayerFrom(payload, bytes.length);
+        assertEquals(1, layer.getByte());
+
+        payload.initLayerPayload(bytes, 3);
+        assertTrue(payload.skipBytes(1));
+        layer.readLayerFrom(payload, 0);
+        assertEquals(1, payload.tell());
+        assertThrows(UncheckedEOFException.class, layer::getByte);
+        assertThrows(UncheckedEOFException.class, () -> layer.readLayerFrom(payload, 3));
+        assertEquals(1, payload.tell());
+        layer.readLayerFrom(payload, 2);
+        assertTrue(layer.seekEnd(1));
+        assertEquals(3, layer.getByte());
+        assertThrows(UncheckedEOFException.class, layer::getByte);
+        assertEquals(3, payload.tell());
+    }
+
+    @Test
+    void keepsOwnedCopiesForTheOrdinaryInputPath() {
+        byte[] bytes = {1, 2, 3};
+        var source = new ByteStreamInArray();
+        source.initLayerPayload(bytes, bytes.length);
+        source.init(bytes, bytes.length);
+        var layer = new ByteStreamInArray();
+        layer.readLayerFrom(source, 2);
+
+        bytes[0] = 9;
+        assertEquals((char) 0x0201, layer.get16bitsLE());
+        assertEquals(2, source.tell());
+        assertThrows(UncheckedEOFException.class, () -> layer.readLayerFrom(source, 2));
+    }
+}
