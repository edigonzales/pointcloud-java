+    // Only applied to the diagnostic build. Per-symbol counting stays on the decoder thread.
+    static final class TableDiagnostics {
+        private static final ConcurrentLinkedQueue<TableDiagnostics> THREADS = new ConcurrentLinkedQueue<>();
+        private static final ThreadLocal<TableDiagnostics> CURRENT = ThreadLocal.withInitial(() -> {
+            var counters = new TableDiagnostics();
+            THREADS.add(counters);
+            return counters;
+        });
+
+        static {
+            Runtime.getRuntime().addShutdownHook(new Thread(TableDiagnostics::report));
+        }
+
+        private final long threadId = Thread.currentThread().threadId();
+        private final Totals[] alphabet = new Totals[2049];
+
+        static void recordSearch(int symbols, int steps) {
+            var totals = CURRENT.get().totals(symbols);
+            totals.steps += steps;
+            if (steps == 0) {
+                totals.zero++;
+            } else if (steps == 1) {
+                totals.one++;
+            } else {
+                totals.twoOrMore++;
+            }
+        }
+
+        static void recordUpdate(int symbols) {
+            CURRENT.get().totals(symbols).updates++;
+        }
+
+        private Totals totals(int symbols) {
+            var totals = alphabet[symbols];
+            if (totals == null) {
+                totals = new Totals();
+                alphabet[symbols] = totals;
+            }
+            return totals;
+        }
+
+        private static void report() {
+            System.err.println("laz-table,thread_id,symbols,zero_steps,one_step,two_plus_steps,total_steps,updates");
+            for (var thread : THREADS) {
+                for (int symbols = 0; symbols < thread.alphabet.length; symbols++) {
+                    var totals = thread.alphabet[symbols];
+                    if (totals != null) {
+                        System.err.println("laz-table," + thread.threadId + "," + symbols + "," +
+                                totals.zero + "," + totals.one + "," + totals.twoOrMore + "," +
+                                totals.steps + "," + totals.updates);
+                    }
+                }
+            }
+        }
+
+        private static final class Totals {
+            long zero;
+            long one;
+            long twoOrMore;
+            long steps;
+            long updates;
+        }
+    }
 }
