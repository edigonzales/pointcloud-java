+def check_queue_refill(command, modes, scratch, pdal, stats):
+    source = scratch / "queue-refill.laz"
+    points = 500_003
+    chunk_size = 50_000
+    generate_fixture(pdal, scratch / "generate-refill.json", [
+        {"type": "readers.faux", "bounds": "([2594000,2596000],[1227500,1227501],[700,701])",
+         "count": points, "mode": "ramp"},
+        {"type": "writers.las", "filename": str(source), "minor_version": 4, "dataformat_id": 6,
+         "compression": True}
+    ])
+    fixture = bytearray(source.read_bytes())
+    point_offset = struct.unpack_from("<I", fixture, 96)[0]
+    table = struct.unpack_from("<Q", fixture, point_offset)[0]
+    chunks = struct.unpack_from("<I", fixture, table + 4)[0]
+    require(chunks == 11, f"Expected eleven fixed LAZ chunks, got {chunks}")
+    print(f"{source.name}: {chunks} chunks exceed the eight-buffer window", flush=True)
+    check_modes(command, modes, scratch, source, [stats], points, points, {2: points})
+
+    # PDRF 6 without extra bytes has a raw seed point, a point count and
+    # nine layer sizes followed by the layer data in each chunk.
+    width = struct.unpack_from("<H", fixture, 105)[0]
+    require(fixture[104] & 0x3f == 6 and width == 30, "Expected PDRF 6 with no extra bytes")
+    layer_headers = []
+    offset = point_offset + 8
+    for index in range(chunks):
+        count_offset = offset + width
+        count = struct.unpack_from("<I", fixture, count_offset)[0]
+        require(count == min(chunk_size, points - index * chunk_size), f"Unexpected count in chunk {index}")
+        layer_header = count_offset + 4
+        layer_sizes = struct.unpack_from("<9I", fixture, layer_header)
+        layer_headers.append(layer_header)
+        offset = layer_header + 4 * len(layer_sizes) + sum(layer_sizes)
+    require(offset == table, "Layer payload sizes do not match the LAZ chunk table offset")
+    damaged = 8
+    struct.pack_into("<I", fixture, layer_headers[damaged], 0x7fff_ffff)
+    before_chunk = damaged * chunk_size
+    corrupt = scratch / "queue-refill-corrupt.laz"
+    corrupt.write_bytes(fixture)
+    for mode in modes[1:]:
+        config, las, metadata = setup(scratch / f"late-corrupt-{mode}", corrupt, [])
+        result = subprocess.run(command(mode, config, metadata), capture_output=True, text=True, timeout=30)
+        require(result.returncode != 0 and f"after {before_chunk} of" in result.stderr and "layer payload" in result.stderr,
+                f"{mode}: expected corruption in chunk {damaged}, got {result.returncode}: {result.stderr}")
+        assert_unpublished(las, metadata)
+        print(f"{mode}: corrupt chunk {damaged} of {chunks} rejected with exit {result.returncode}; "
+              "no output published", flush=True)
+
+
