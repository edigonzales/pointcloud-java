{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": ".cache/test-data/so-2019.laz"
    },
    {
      "type": "filters.crop",
      "bounds": "([2594100,2594300],[1227600,1227800])"
    },
    {
      "type": "filters.expression",
      "expression": "Classification == 2 && Withheld == 0"
    },
    {
      "type": "filters.stats",
      "dimensions": "Intensity"
    },
    {
      "type": "writers.raster",
      "filename": "build/results/ground-grid-intensity.tif",
      "resolution": 1,
      "origin_x": 2594100,
      "origin_y": 1227600,
      "width": 200,
      "height": 200,
      "binmode": true,
      "dimension": "Intensity",
      "data_type": "double",
      "nodata": -9999,
      "output_type": "min,max,mean,count,stdev",
      "window_size": 5,
      "compression": "none"
    }
  ]
}
